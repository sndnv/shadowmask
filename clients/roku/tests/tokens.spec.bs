namespace tests

    @suite("tokens")
    class TokenTests extends rooibos.BaseTestSuite

        @describe("theme tables")

        @it("carries every colour token in every theme")
        sub everyThemeIsComplete()
            expected = [
                "bg", "surface", "surfaceAlt", "text", "muted", "border",
                "accent", "accentContrast", "ok", "warn", "danger", "dangerContrast",
                "okBg", "warnBg", "dangerBg", "artBg",
                "rowOk", "rowWarn", "rowDanger"
            ]

            for each name in ThemeNames()
                tokens = ThemeTokens(name)
                for each key in expected
                    m.assertTrue(tokens.DoesExist(key), name + " is missing " + key)
                end for
            end for
        end sub

        @it("states every colour as 0xRRGGBBAA")
        sub coloursAreWellFormed()
            for each name in ThemeNames()
                tokens = ThemeTokens(name)
                for each key in tokens
                    value = tokens[key]
                    if type(value) = "String" or type(value) = "roString"
                        m.assertEqual(Len(value), 10, name + "." + key + " is not 0xRRGGBBAA")
                        m.assertEqual(Left(value, 2), "0x", name + "." + key + " lacks the 0x prefix")
                    end if
                end for
            end for
        end sub

        @it("falls back to the default theme for an unknown name")
        sub unknownThemeFallsBack()
            m.assertEqual(ThemeTokens("nonsense").bg, ThemeTokens(DefaultThemeName()).bg)
        end sub

        @it("marks light as the only theme that is not dark")
        sub lightIsTheOnlyLightTheme()
            m.assertFalse(ThemeTokens("light").isDark)
            m.assertTrue(ThemeTokens("dark").isDark)
            m.assertTrue(ThemeTokens("retro").isDark)
        end sub

        @describe("row tints")

        @it("derives row tints from their base colour at the tint alpha")
        sub rowTintsAreDerived()
            tokens = ThemeTokens("dark")
            m.assertEqual(tokens.rowOk, Left(tokens.ok, 8) + RowTintAlpha())
            m.assertEqual(tokens.rowWarn, Left(tokens.warn, 8) + RowTintAlpha())
            m.assertEqual(tokens.rowDanger, Left(tokens.danger, 8) + RowTintAlpha())
        end sub

        @describe("toast")

        @it("gives the message a space more than it measures, so a rounded-down width cannot cut it")
        sub toastKeepsTheWholeMessage()
            m.assertEqual(ToastLabelWidth(120, 7), 127)
            m.assertTrue(ToastLabelWidth(TextWidth("Report sent.", 28), SpaceWidth(28)) > TextWidth("Report sent.", 28))
        end sub

        @describe("scales")

        @it("turns a size authored at 1.75 into Flutter's size times the density scale")
        sub pxFollowsTheDensityScale()
            m.assertEqual(Px(28), Int(16 * DensityScale() + 0.5))
            m.assertEqual(Px(AuthoredScale() * 64), Int(64 * DensityScale() + 0.5))
            m.assertEqual(Px(0), 0)
        end sub

        @it("keeps body text at the readable floor and orders the scale")
        sub typeScaleIsOrdered()
            sizes = TypeScale()
            m.assertEqual(sizes.textBase, Px(28))
            m.assertTrue(sizes.text2xl > sizes.textXl)
            m.assertTrue(sizes.textXl > sizes.textLg)
            m.assertTrue(sizes.textLg > sizes.textBase)
            m.assertTrue(sizes.textBase > sizes.textSm)
            m.assertTrue(sizes.textSm > sizes.textXs)
        end sub

        @it("keeps spacing on the design system scale times the density scale")
        sub spacingMatchesTheDesignSystem()
            space = SpacingScale()
            m.assertEqual(space.s4, Int(16 * DensityScale() + 0.5))
            m.assertEqual(space.s1, Int(4 * DensityScale() + 0.5))
            m.assertEqual(space.s10, Int(64 * DensityScale() + 0.5))
        end sub

        @it("keeps the sizes baked into the button images whatever the density, and the ring hugging the button")
        sub imageSizesIgnoreDensity()
            m.assertEqual(CornerRadius(), 10)
            m.assertEqual(FocusRingInset(), 3)
            m.assertEqual(FocusRingRadius(), CornerRadius() + FocusRingInset())
        end sub

        @it("keeps the screen's edge gaps whatever the density, so content stays inside the action-safe area")
        sub edgeGapsIgnoreDensity()
            m.assertEqual(ContentLeft(), 98)
            m.assertEqual(ContentTop(), 98)
            m.assertTrue(ContentLeft() > Int(CanvasWidth() * 0.05), "content is not past the action-safe line")
        end sub

        @it("authors against a fixed 1920x1080 canvas")
        sub canvasIsFixed()
            m.assertEqual(CanvasWidth(), 1920)
            m.assertEqual(CanvasHeight(), 1080)
        end sub

        @it("builds each scale once and hands back the same table after that")
        sub scalesAreMemoized()
            first = TypeScale()
            first.probe = 1
            m.assertEqual(TypeScale().probe, 1)
            TypeScale().Delete("probe")

            spacing = SpacingScale()
            spacing.probe = 2
            m.assertEqual(SpacingScale().probe, 2)
            SpacingScale().Delete("probe")
        end sub

        @describe("fonts")

        @it("names the medium family after the regular one, and nothing without fonts")
        sub familyNamesFollowTheFontSet()
            names = FamilyNamesFor({ name: "Noto Sans CJK SC" })
            m.assertEqual(names.regular, "Noto Sans CJK SC")
            m.assertEqual(names.bold, "Noto Sans CJK SC Medium")

            m.assertEqual(FamilyNamesFor({}).regular, "")
            m.assertEqual(FamilyNamesFor(invalid).bold, "")
        end sub

        @it("finds a role's file in the font set, or nothing")
        sub findsARolesFile()
            fonts = { name: "Noto Sans CJK SC", regular: "cachefs:/fonts/a.otf" }
            m.assertEqual(FontPathIn(fonts, "regular"), "cachefs:/fonts/a.otf")
            m.assertEqual(FontPathIn(fonts, "medium"), "")
            m.assertEqual(FontPathIn({}, "regular"), "")
        end sub

        @it("falls back to the bold system font for medium and the plain one otherwise")
        sub systemFontPerRole()
            m.assertEqual(SystemFontName("medium"), "font:MediumBoldSystemFont")
            m.assertEqual(SystemFontName("regular"), "font:MediumSystemFont")
        end sub

        @it("points a font node at a downloaded file, at the size asked")
        sub fontNodeUsesTheFile()
            font = FontNode("cachefs:/fonts/a.otf", "font:MediumSystemFont", 30)
            m.assertEqual(font.uri, "cachefs:/fonts/a.otf")
            m.assertEqual(font.size, 30)
        end sub

        @it("takes the system font, at the size asked, when there is no file")
        sub fontNodeFallsBackToTheSystemFont()
            font = FontNode("", "font:MediumSystemFont", 30)
            m.assertNotInvalid(font)
            m.assertEqual(font.size, 30)
        end sub

        @it("re-points a cached font at its role's new file, and drops it when the role has none")
        sub cachedFontsFollowTheirRole()
            fonts = { name: "Noto Sans CJK SC", regular: "cachefs:/fonts/r.otf", medium: "cachefs:/fonts/m.otf" }
            m.assertEqual(CachedFontUri("regular:30", fonts), "cachefs:/fonts/r.otf")
            m.assertEqual(CachedFontUri("medium:24.5", fonts), "cachefs:/fonts/m.otf")
            m.assertEqual(CachedFontUri("regular:30", {}), "")
        end sub

        @it("remembers on the shared node that the font registry was refused")
        sub remembersRefusedRegistry()
            m.assertFalse(FontRegistryRefused(invalid))

            bare = CreateObject("roSGNode", "Node")
            NoteFontRegistryRefused(bare)
            m.assertFalse(FontRegistryRefused(bare))

            shared = CreateObject("roSGNode", "Node")
            shared.AddFields({ fontRegistryRefused: false })
            m.assertFalse(FontRegistryRefused(shared))
            NoteFontRegistryRefused(shared)
            m.assertTrue(FontRegistryRefused(shared))
            NoteFontRegistryRefused(invalid)
        end sub

        @it("does not ask for the font registry once it was refused")
        sub skipsRefusedRegistry()
            shared = GetGlobalAA()
            had = shared.DoesExist("global")
            kept = shared.global
            watched = shared.DoesExist("smFontsWatched")
            refused = CreateObject("roSGNode", "Node")
            refused.AddFields({ fontRegistryRefused: true })
            shared.global = refused
            ForgetTextMeasures()

            LoadFontRegistry()

            m.assertFalse(shared.DoesExist("smFontRegistry"))
            ForgetTextMeasures()
            if had then shared.global = kept else shared.Delete("global")
            if not watched then shared.Delete("smFontsWatched")
        end sub

        @it("forgets every measure taken in the old font")
        sub forgetsTheOldMeasures()
            keys = ["smFontFamilies", "smFonts", "smFontRegistry", "smMeasureLabels", "smLineHeights", "smMiddleEllipsis", "smWordMeasure", "smLineCount"]
            shared = GetGlobalAA()
            for each key in keys
                shared[key] = { probe: true }
            end for

            ForgetTextMeasures()

            for each key in keys
                m.assertFalse(shared.DoesExist(key), key)
            end for
        end sub

        @it("keeps each file under its hash, with the extension its url has")
        sub cachePathFollowsTheHash()
            hash = "2c76254f6fc379fddfce0a7e84fb5385bb135d3e399294f6eeb6680d0365b74b"
            m.assertEqual(FontCachePath({ url: "/fonts/NotoSansCJKsc-Regular.otf", sha256: hash }), "cachefs:/fonts/" + hash + ".otf")
            m.assertEqual(FontCachePath({ url: "/fonts/LICENSE", sha256: UCase(hash) }), "cachefs:/fonts/" + hash)
        end sub

        @it("keeps nothing for a hash that is not 64 hex digits")
        sub cachePathRefusesABadHash()
            m.assertEqual(FontCachePath({ url: "/fonts/a.otf", sha256: "../../registry" }), "")
            m.assertEqual(FontCachePath({ url: "/fonts/a.otf", sha256: "abc" }), "")
            m.assertEqual(FontCachePath(invalid), "")
        end sub

        @it("plans one download per role, against the server's address")
        sub plansTheDownloads()
            plan = FontDownloads(m.ServedFonts(), "http://10.0.0.2:8080/")

            m.assertEqual(plan.name, "Noto Sans CJK SC")
            m.assertEqual(plan.files.Count(), 3)
            m.assertEqual(plan.files[0].role, "regular")
            m.assertEqual(plan.files[0].url, "http://10.0.0.2:8080/fonts/Regular.otf")
            m.assertEqual(plan.files[0].path, "cachefs:/fonts/" + String(64, "a") + ".otf")
            m.assertEqual(plan.files[0].size, 16437364)
            m.assertEqual(plan.files[1].role, "medium")
            m.assertEqual(plan.files[2].role, "license")
        end sub

        @it("plans nothing when the server has no usable font set")
        sub plansNothingWithoutFonts()
            m.assertInvalid(FontDownloads(invalid, "http://h"))
            m.assertInvalid(FontDownloads({}, "http://h"))

            missing = m.ServedFonts()
            missing.Delete("medium")
            m.assertInvalid(FontDownloads(missing, "http://h"))

            unsized = m.ServedFonts()
            unsized.regular.size = "16437364"
            m.assertInvalid(FontDownloads(unsized, "http://h"))

            elsewhere = m.ServedFonts()
            elsewhere.license.url = "http://elsewhere/LICENSE"
            m.assertInvalid(FontDownloads(elsewhere, "http://h"))
        end sub

        @it("plans the italic pair after the set when the server serves both")
        sub plansTheItalicPair()
            plan = FontDownloads(m.ItalicFonts(), "http://h")

            m.assertEqual(plan.files.Count(), 5)
            m.assertEqual(plan.files[3].role, "italic")
            m.assertEqual(plan.files[3].url, "http://h/fonts/NotoSans-Italic.ttf")
            m.assertEqual(plan.files[3].path, "cachefs:/fonts/" + String(64, "d") + ".ttf")
            m.assertEqual(plan.files[4].role, "italic_license")

            fonts = ActiveFontsFrom(plan)
            m.assertEqual(fonts.italic, "cachefs:/fonts/" + String(64, "d") + ".ttf")
            m.assertEqual(fonts.italic_license, "cachefs:/fonts/" + String(64, "e"))
        end sub

        @it("plans the set without italic when the pair is incomplete or unusable")
        sub plansWithoutABrokenItalicPair()
            half = m.ItalicFonts()
            half.Delete("italic_license")

            unhashed = m.ItalicFonts()
            unhashed.italic.sha256 = "abc"

            elsewhere = m.ItalicFonts()
            elsewhere.italic_license.url = "http://elsewhere/LICENSE"

            unsent = m.ItalicFonts()
            unsent.italic = invalid

            for each fonts in [half, unhashed, elsewhere, unsent]
                plan = FontDownloads(fonts, "http://h")
                m.assertEqual(plan.files.Count(), 3)
                m.assertFalse(ActiveFontsFrom(plan).DoesExist("italic"))
            end for
        end sub

        @it("publishes each role's saved path under the set's name")
        sub publishesTheSavedPaths()
            fonts = ActiveFontsFrom(FontDownloads(m.ServedFonts(), "http://h"))

            m.assertEqual(fonts.name, "Noto Sans CJK SC")
            m.assertEqual(fonts.regular, "cachefs:/fonts/" + String(64, "a") + ".otf")
            m.assertEqual(fonts.medium, "cachefs:/fonts/" + String(64, "b") + ".otf")
            m.assertEqual(fonts.license, "cachefs:/fonts/" + String(64, "c"))
        end sub

        @it("hands the task the folder, the files, the certificates and a timeout")
        sub buildsTheJob()
            plan = FontDownloads(m.ServedFonts(), "http://h")
            job = FontJob(plan)

            m.assertEqual(job.directory, FontsDirectory())
            m.assertEqual(job.files.Count(), 3)
            m.assertEqual(job.certificates, CertificatesFile())
            m.assertTrue(job.timeout > 0)
        end sub

        function ServedFonts() as object
            return {
                name: "Noto Sans CJK SC",
                regular: { url: "/fonts/Regular.otf", size: 16437364, sha256: String(64, "a") },
                medium: { url: "/fonts/Medium.otf", size: 16523632, sha256: String(64, "b") },
                license: { url: "/fonts/LICENSE", size: 4301, sha256: String(64, "c") }
            }
        end function

        function ItalicFonts() as object
            fonts = m.ServedFonts()
            fonts.italic = { url: "/fonts/NotoSans-Italic.ttf", size: 639124, sha256: String(64, "d") }
            fonts.italic_license = { url: "/fonts/LICENSE-NotoSans", size: 4400, sha256: String(64, "e") }
            return fonts
        end function

        @describe("high contrast")

        @it("hands back the plain theme when contrast is off")
        sub plainThemeWhenOff()
            for each name in ThemeNames()
                m.assertEqual(ThemedTokens(name, false).muted, ThemeTokens(name).muted)
            end for
        end sub

        @it("retires muted and border onto the text colour, which is the whole hardening")
        sub hardensEveryTheme()
            for each name in ThemeNames()
                plain = ThemeTokens(name)
                hard = ThemedTokens(name, true)

                m.assertEqual(hard.muted, plain.text)
                m.assertEqual(hard.border, plain.text)
                m.assertEqual(hard.bg, plain.bg)
                m.assertEqual(hard.accent, plain.accent)
            end for
        end sub

        @it("raises the row tints so a status row still reads once the border is loud")
        sub raisesRowTints()
            plain = ThemeTokens("dark")
            hard = ThemedTokens("dark", true)

            m.assertNotEqual(hard.rowOk, plain.rowOk)
            m.assertEqual(Left(hard.rowOk, 8), Left(plain.ok, 8))
        end sub

        @describe("backdrop fades")

        @it("lets the wash outlast the first frame when the player is what it is leaving")
        sub playerBackdropOutlastsTheFirstFrame()
            m.assertTrue(BackdropFadeOutSeconds(true) > BackdropFadeOutSeconds(false), "the player fade-out is not the longer one")
            m.assertEqual(BackdropFadeOutSeconds(false), BackdropFadeSeconds())
        end sub

        @it("fades in more slowly than it fades out of an ordinary screen")
        sub fadeInIsTheSlowerOne()
            m.assertTrue(BackdropFadeInSeconds() > BackdropFadeSeconds(), "the fade-in is not the slower one")
        end sub

        @describe("nav menu")

        @it("floats the overscan-safe menu inside the action-safe area")
        sub menuFloatsInsideTheSafeArea()
            m.assertTrue(NavLeft(true) > Int(CanvasWidth() * 0.05), "the menu is not past the action-safe line")
            m.assertTrue(NavTop(true) > Int(CanvasHeight() * 0.05), "the menu is not below the action-safe line")
        end sub

        @it("keeps the default menu one edge gap from the left, top and bottom")
        sub menuHugsTheEdges()
            m.assertEqual(NavLeft(false), NavEdgeGap())
            m.assertEqual(NavTop(false), NavEdgeGap())
            m.assertEqual(NavEdgeGap(), 32)
        end sub

        @it("puts the overscan-safe menu further in than the default one")
        sub safeMenuSitsFurtherIn()
            m.assertTrue(NavLeft(true) > NavLeft(false), "the overscan-safe menu is not further right")
            m.assertTrue(NavTop(true) > NavTop(false), "the overscan-safe menu is not further down")
        end sub

        @it("leaves the same gap above and below the menu")
        sub menuGapsMatch()
            m.assertEqual(NavPanelHeight(true) + NavTop(true) * 2, CanvasHeight())
            m.assertEqual(NavPanelHeight(false) + NavTop(false) * 2, CanvasHeight())
        end sub

        @it("lets the screen show through the menu")
        sub menuIsSeeThrough()
            theme = ThemeTokens("dark")
            colour = NavPanelColor(theme)

            m.assertEqual(Left(colour, 8), Left(theme.surface, 8))
            m.assertNotEqual(Right(colour, 2), "FF")
        end sub

        @it("puts the closed indicator at the menu's left edge, centred and faded")
        sub closedIndicatorFloats()
            for each inset in [true, false]
                layout = NavHintLayout(false, 380, inset)

                m.assertEqual(layout.x, NavLeft(inset))
                m.assertEqual(layout.y * 2 + layout.disc, CanvasHeight())
                m.assertEqual(layout.chevronX * 2 + NavHintChevronSize(), layout.disc)
                m.assertEqual(layout.chevronY * 2 + NavHintChevronSize(), layout.disc)
                m.assertEqual(layout.clip, [0, 0, layout.disc, layout.disc])
                m.assertTrue(layout.opacity < 1, "the closed indicator is not faded")
            end for
        end sub

        @it("shows only the half of the open indicator outside the menu's right edge")
        sub openIndicatorStraddlesTheEdge()
            for each inset in [true, false]
                layout = NavHintLayout(true, 380, inset)
                half = layout.disc \ 2

                m.assertEqual(layout.x + half, NavLeft(inset) + 380)
                m.assertEqual(layout.y * 2 + layout.disc, CanvasHeight())
                m.assertEqual(layout.clip, [half, 0, half, layout.disc])
                m.assertEqual((layout.chevronX - half) * 2 + NavHintChevronSize(), half)
                m.assertEqual(layout.chevronY * 2 + NavHintChevronSize(), layout.disc)
                m.assertTrue(layout.opacity > NavHintLayout(false, 380, inset).opacity, "the open indicator is not the stronger one")
            end for
        end sub

        @it("fits the chevron inside the half of the open indicator that shows")
        sub chevronFitsTheTab()
            m.assertTrue(NavHintChevronSize() < NavHintSize() \ 2, "the chevron is wider than the tab")
        end sub

        @it("draws both indicators from one disc size")
        sub indicatorsMatch()
            for each inset in [true, false]
                m.assertEqual(NavHintLayout(false, 380, inset).disc, NavHintSize())
                m.assertEqual(NavHintLayout(true, 380, inset).disc, NavHintSize())
            end for
        end sub

        @it("lights a menu row only while it holds the focus and the menu has it")
        sub rowLightsWithFocus()
            m.assertTrue(NavRowLit(1.0, true), "the focused row of a focused menu is not lit")
            m.assertFalse(NavRowLit(1.0, false), "a row is lit while the menu has no focus")
            m.assertFalse(NavRowLit(0.5, true), "a row half way through the focus move is lit")
            m.assertTrue(NavRowLit(0.51, true), "a row past half way through the focus move is not lit")
            m.assertFalse(NavRowLit(0.0, true), "an unfocused row is lit")
        end sub

        @it("draws a lit menu row bold on the accent's contrast colour, the others regular and muted")
        sub rowLook()
            for each name in ThemeNames()
                theme = ThemeTokens(name)

                lit = NavRowLook(theme, true)
                m.assertEqual(lit.color, theme.accentContrast)
                m.assertTrue(lit.bold, "a lit row is not bold")

                plain = NavRowLook(theme, false)
                m.assertEqual(plain.color, theme.muted)
                m.assertFalse(plain.bold, "a row that is not lit is bold")
            end for
        end sub

    end class

end namespace
