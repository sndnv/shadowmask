namespace tests

    @suite("playback")
    class PlaybackTests extends rooibos.BaseTestSuite

        function startingState() as object
            return PlaybackStep(PlaybackOpens("v1", DefaultControls()), { kind: "opened", durationMs: 600000, resumeMs: 0, remote: DefaultControls() }).state
        end function

        function watchingState() as object
            started = PlaybackStep(m.startingState(), { kind: "started", id: 1, json: { session_id: "s1", manifest_url: "/stream/t/master.m3u8", mode: "direct", heartbeat_interval_s: 10 } }).state
            return PlaybackStep(started, { kind: "loaded", id: 1 }).state
        end function

        function placedState() as object
            return PlaybackStep(m.watchingState(), { kind: "reads", reading: { positionMs: 0, durationMs: 600000, bufferedAheadMs: 0, playing: true, ended: false } }).state
        end function

        @describe("the nodes the player is built from")

        @it("can create every custom node WatchScreen expects to find")
        sub everyPlayerNodeExists()
            ' A component that fails to register returns invalid from FindNode
            ' rather than erroring, and the screen then dies on the first dot
            ' operator, which reads as "no key does anything".
            for each name in ["Timeline", "ActionBar", "StateNote", "WatchScreen"]
                m.assertNotInvalid(CreateObject("roSGNode", name), name + " did not register")
            end for
        end sub

        @describe("the converting default")

        @it("keeps only a value the player offers")
        sub keepsOfferedDelivery()
            m.assertEqual(ValidDelivery("always"), "always")
            m.assertEqual(ValidDelivery("NEVER"), "never")
            m.assertEqual(ValidDelivery("sometimes"), "auto")
            m.assertEqual(ValidDelivery(invalid), "auto")
        end sub

        @it("starts a video's controls from the saved default")
        sub startsFromSavedDelivery()
            controls = WithDefaultDelivery(DefaultControls(), "always")

            m.assertEqual(controls.delivery, "always")
            m.assertEqual(ControlsStartBody(controls).delivery, "always")
            m.assertEqual(ControlsUpdateBody(controls).delivery, "always")
        end sub

        @it("leaves an Auto default off the start body")
        sub autoDeliveryStaysImplicit()
            controls = WithDefaultDelivery(DefaultControls(), "auto")

            m.assertFalse(ControlsStartBody(controls).DoesExist("delivery"))
        end sub

        @describe("StreamUrl")

        @it("keeps the stream path outside the api prefix")
        sub keepsStreamOutsideApi()
            m.assertEqual(StreamUrl("http://host:8081", "/stream/tok/master.m3u8"), "http://host:8081/stream/tok/master.m3u8")
        end sub

        @it("passes an absolute url through untouched")
        sub passesAbsoluteThrough()
            m.assertEqual(StreamUrl("http://host", "http://other/stream/tok/file"), "http://other/stream/tok/file")
        end sub

        @it("is blank when there is no manifest")
        sub blankWithoutManifest()
            m.assertEqual(StreamUrl("http://host", ""), "")
        end sub

        @describe("StreamFormatFor")

        @it("plays every converted session as hls")
        sub convertedIsAlwaysHls()
            m.assertEqual(StreamFormatFor("transcode", "mkv"), "hls")
            m.assertEqual(StreamFormatFor("remux", "mp4"), "hls")
        end sub

        @it("maps the file's own extension for direct play")
        sub directPlayUsesTheContainer()
            m.assertEqual(StreamFormatFor("direct", "mkv"), "mkv")
            m.assertEqual(StreamFormatFor("direct", "MP4"), "mp4")
            m.assertEqual(StreamFormatFor("direct", "m4v"), "mp4")
            m.assertEqual(StreamFormatFor("direct", "ts"), "ts")
            m.assertEqual(StreamFormatFor("direct", "wat"), "mp4")
        end sub

        @describe("AttachSeconds")

        @it("starts a restarted stream at the resume point inside its first segment")
        sub restartedStreamStartsAtResume()
            m.assertEqual(AttachSeconds(90000, 88000), 2)
            m.assertEqual(AttachSeconds(90000, 90000), 0)
        end sub

        @it("starts a complete playlist at the resume point")
        sub completePlaylistStartsAtResume()
            m.assertEqual(AttachSeconds(90000, 0), 90)
            m.assertEqual(AttachSeconds(0, 0), 0)
            m.assertEqual(AttachSeconds(1000, 4000), 0)
        end sub

        @describe("IsReplayKey")

        @it("answers to the name the firmware sends for the instant replay button")
        sub knowsTheReplayKey()
            ' The player only ever matched "instantreplay", which is the ECP spelling;
            ' SceneGraph delivers "replay", so the key did nothing on a real remote.
            m.assertTrue(IsReplayKey("replay"))
            m.assertTrue(IsReplayKey("instantreplay"))
            m.assertTrue(IsReplayKey("InstantReplay"))
            m.assertFalse(IsReplayKey("rewind"))
            m.assertFalse(IsReplayKey(invalid))
        end sub

        @describe("HoldStepMs")

        @it("starts at ten seconds and escalates every three seconds held")
        sub holdStepClimbs()
            m.assertEqual(HoldStepMs(0), 10000)
            m.assertEqual(HoldStepMs(2), 10000)
            m.assertEqual(HoldStepMs(3), 30000)
            m.assertEqual(HoldStepMs(5), 30000)
            m.assertEqual(HoldStepMs(6), 50000)
            m.assertEqual(HoldStepMs(9), 100000)
        end sub

        @it("stays at the fastest rung however long the key is held")
        sub holdStepTopsOut()
            m.assertEqual(HoldStepMs(30), 100000)
            m.assertEqual(HoldStepMs(600), 100000)
        end sub

        @describe("HoldSpeedAt")

        @it("reports the multiplier behind the step")
        sub holdSpeedRungs()
            m.assertEqual(HoldSpeedAt(0), 1)
            m.assertEqual(HoldSpeedAt(2), 1)
            m.assertEqual(HoldSpeedAt(3), 3)
            m.assertEqual(HoldSpeedAt(6), 5)
            m.assertEqual(HoldSpeedAt(9), 10)
            m.assertEqual(HoldSpeedAt(600), 10)
        end sub

        @describe("HoldTickStepMs")

        @it("splits the per-second rate across four ticks a second")
        sub holdTickSplitsTheRate()
            ' Four 250ms ticks have to add up to the second they replace, or
            ' the finer feedback would quietly change how fast seeking is.
            first = 0
            for tick = 0 to 3
                first = first + HoldTickStepMs(tick)
            end for
            m.assertEqual(first, HoldStepMs(0))

            fastest = 0
            for tick = 36 to 39
                fastest = fastest + HoldTickStepMs(tick)
            end for
            m.assertEqual(fastest, HoldStepMs(9))
        end sub

        @it("escalates on held seconds, not on tick count")
        sub holdTickEscalatesOnSeconds()
            m.assertEqual(HoldTickStepMs(11), 2500)
            m.assertEqual(HoldTickStepMs(12), 7500)
        end sub

        @describe("HoldTickMultiplied")

        ' The screen stops seeking the video and moves only the ghost pointer
        ' once this turns true, so the boundary is the moment the picture stops
        ' chasing the key and the jump waits for the release.
        @it("turns on with the first multiplier rung, not before")
        sub holdTickMultipliedGate()
            m.assertFalse(HoldTickMultiplied(0))
            m.assertFalse(HoldTickMultiplied(11))
            m.assertTrue(HoldTickMultiplied(12))
            m.assertTrue(HoldTickMultiplied(600))
        end sub

        @describe("PlayerButtons")

        @it("centres the transport between two clusters of the same width")
        sub playerButtonsCluster()
            ids = []
            for each button in PlayerButtons(true, false, false, false, false)
                ids.Push(button.id)
            end for

            m.assertEqual(ids, ["quality", "subtitle", "play", "audio", "settings"])
        end sub

        @it("shows the pause icon only while playing")
        sub playerButtonsIcon()
            m.assertEqual(PlayerButtons(true, false, false, false, false)[2].icon, "icon-pause")
            m.assertEqual(PlayerButtons(false, false, false, false, false)[2].icon, "icon-play")
        end sub

        @it("restarts from the transport once the title has finished")
        sub playerButtonsFinished()
            ' The whole bar stays, so subtitles and settings are still reachable
            ' after the credits rather than collapsing to one button. The icon
            ' stays a plain play, matching the Flutter overlay bar; only the
            ' centre badge carries the replay glyph.
            buttons = PlayerButtons(false, true, false, false, false)

            m.assertEqual(buttons.Count(), 5)
            m.assertEqual(buttons[2].id, "replay")
            m.assertEqual(buttons[2].icon, "icon-play")
            m.assertEqual(buttons[2].label, Phrase("player.replay"))
        end sub

        @it("keeps both episode buttons in place and disables the one with nowhere to go")
        sub playerButtonsEpisode()
            ' Both are always drawn so play/pause stays dead centre; the first
            ' episode of a series simply has a dimmed Previous.
            buttons = PlayerButtons(true, false, true, false, true)

            m.assertEqual(buttons[2].id, "previous")
            m.assertTrue(buttons[2].disabled)
            m.assertEqual(buttons[4].id, "next")
            m.assertFalse(buttons[4].disabled)
        end sub

        @it("leaves only the settings enabled during a change")
        sub playerButtonsBusy()
            for each button in PlayerButtons(true, false, true, true, true, true)
                m.assertEqual(ValueAt(button, "disabled", false) = true, button.id <> "settings", button.id)
            end for

            for each button in PlayerButtons(true, false, true, true, true)
                m.assertFalse(ValueAt(button, "disabled", false) = true, button.id)
            end for

            m.assertTrue(PlayerButtons(false, true, false, false, false, true)[2].disabled)
        end sub

        @describe("PlaybackNote")

        @it("shows the loading note until the gather and the change in flight are done")
        sub noteWhileLoading()
            fresh = PlaybackOpens("v1", DefaultControls())
            m.assertEqual(PlaybackNote(fresh, "Loading Alien…").kind, "loading")
            m.assertEqual(PlaybackNote(fresh, "Loading Alien…").message, "Loading Alien…")

            starting = m.startingState()
            m.assertEqual(PlaybackNote(starting, "Loading Alien…").kind, "loading")
            m.assertEqual(PlaybackNote(starting, "Loading Alien…").message, "Loading Alien…")
        end sub

        @it("says when a change is taking longer than usual")
        sub noteWhenSlow()
            slow = PlaybackStep(m.startingState(), { kind: "changeSlow", id: 1 }).state

            m.assertEqual(PlaybackNote(slow, "Loading Alien…").kind, "loading")
            m.assertEqual(PlaybackNote(slow, "Loading Alien…").message, "Loading Alien… " + Phrase("player.slow"))
        end sub

        @it("shows the error in place of the loading note")
        sub noteShowsTheError()
            refused = PlaybackStep(m.startingState(), { kind: "refusedStart", id: 1, message: "Could not play (gone)." }).state
            note = PlaybackNote(refused, "Loading Alien…")

            m.assertEqual(note.kind, "error")
            m.assertEqual(note.message, "Could not play (gone).")
        end sub

        @it("keeps the loading note after the load until the first frame shows")
        sub noteUntilTheFirstFrame()
            loaded = m.watchingState()
            m.assertEqual(PlaybackNote(loaded, "Loading Alien…").kind, "loading")
            m.assertEqual(PlaybackNote(loaded, "Loading Alien…").message, "Loading Alien…")

            paused = PlaybackStep(loaded, { kind: "toggle" }).state
            m.assertEqual(PlaybackNote(paused, "Loading Alien…").kind, "empty")
        end sub

        @it("shows nothing while watching or once closed")
        sub noteClearsWhileWatching()
            watching = m.placedState()
            m.assertEqual(PlaybackNote(watching, "Loading Alien…").kind, "empty")
            m.assertEqual(PlaybackNote(watching, "Loading Alien…").message, "")

            ended = PlaybackStep(watching, { kind: "reads", reading: { positionMs: 600000, durationMs: 600000, bufferedAheadMs: 0, playing: false, ended: true } }).state
            m.assertEqual(PlaybackNote(ended, "Loading Alien…").kind, "empty")

            refused = PlaybackStep(m.startingState(), { kind: "refusedStart", id: 1, message: "Could not play (gone)." }).state
            closed = PlaybackStep(refused, { kind: "leave" }).state
            m.assertEqual(PlaybackNote(closed, "Loading Alien…").kind, "empty")
            m.assertEqual(PlaybackNote(closed, "Loading Alien…").message, "")
        end sub

        @describe("PausedGlyph")

        @it("marks a paused stream with play")
        sub pausedMarkWhilePaused()
            paused = PlaybackStep(m.watchingState(), { kind: "toggle" }).state

            m.assertEqual(PausedGlyph(paused), "icon-play-large")
        end sub

        @it("marks the end with replay")
        sub pausedMarkAtTheEnd()
            ended = PlaybackStep(m.watchingState(), { kind: "reads", reading: { positionMs: 600000, durationMs: 600000, bufferedAheadMs: 0, playing: false, ended: true } }).state

            m.assertEqual(PausedGlyph(ended), "icon-replay-large")
        end sub

        @it("shows no mark while playing, during a change or without a stream")
        sub noPausedMarkOtherwise()
            watching = m.watchingState()
            m.assertEqual(PausedGlyph(watching), "")

            lower = DefaultControls()
            lower.height = 480
            changing = PlaybackStep(PlaybackStep(watching, { kind: "toggle" }).state, { kind: "changeRemote", controls: lower }).state
            m.assertEqual(PausedGlyph(changing), "")

            m.assertEqual(PausedGlyph(PlaybackOpens("v1", DefaultControls())), "")
        end sub

        @describe("NoticeText")

        @it("words each notice a failed change leaves behind")
        sub wordsTheNotices()
            m.assertEqual(NoticeText("changeFailed"), "Could not switch playback options.")
            m.assertEqual(NoticeText("seekFailed"), "Could not jump to that point.")
            m.assertEqual(NoticeText(""), "")
        end sub

        @describe("UpNextLabel")

        @it("shows the episode code and name, not the full player title")
        sub upNextLabelPrefersTheShortForm()
            ' The header already carries the show name; repeating it here just
            ' pushes the episode title out of a one-line label.
            target = { title: "Severance · S02E01 · Pilot", label: "S02E01 · Pilot" }

            m.assertEqual(UpNextLabel(target), "S02E01 · Pilot")
        end sub

        @it("falls back to the title when no short label was built")
        sub upNextLabelFallsBack()
            m.assertEqual(UpNextLabel({ title: "Pilot" }), "Pilot")
            m.assertEqual(UpNextLabel(invalid), "")
        end sub

        @describe("TransportIndex")

        @it("lands on the transport wherever the clusters put it")
        sub transportIndexFindsPlay()
            ' The episode layout inserts Previous ahead of it, so the index is
            ' not a constant the bar can assume.
            m.assertEqual(TransportIndex(PlayerButtons(true, false, false, false, false)), 2)
            m.assertEqual(TransportIndex(PlayerButtons(true, false, true, true, true)), 3)
            m.assertEqual(TransportIndex(PlayerButtons(false, true, false, false, false)), 2)
        end sub

        @it("falls back to the first button when there is no transport")
        sub transportIndexFallsBack()
            m.assertEqual(TransportIndex([{ id: "retry" }]), 0)
            m.assertEqual(TransportIndex([{ id: "quality" }, { id: "settings" }]), 0)
            m.assertEqual(TransportIndex(invalid), 0)
        end sub

        @describe("TitleWithYear")

        @it("appends the year when there is one")
        sub titleWithYear()
            m.assertEqual(TitleWithYear("Arrival", 2016), "Arrival (2016)")
        end sub

        @it("leaves the title alone when the year is unknown")
        sub titleWithoutYear()
            m.assertEqual(TitleWithYear("S1E3 Pilot", invalid), "S1E3 Pilot")
            m.assertEqual(TitleWithYear("", 2016), "")
        end sub

        @describe("PreviousEpisodeBefore")

        @it("walks back one episode in the ordered season")
        sub previousEpisodeWalksBack()
            episodes = [
                { id: "e1", number: 1 },
                { id: "e2", number: 2 },
                { id: "e3", number: 3 }
            ]

            m.assertEqual(PreviousEpisodeBefore(episodes, "e3").id, "e2")
            m.assertInvalid(PreviousEpisodeBefore(episodes, "e1"))
            m.assertInvalid(PreviousEpisodeBefore(episodes, "nope"))
        end sub

        @describe("LastEpisodeOf")

        @it("takes the final episode so a season boundary steps backwards")
        sub lastEpisodeOfSeason()
            episodes = [{ id: "e2", number: 2 }, { id: "e1", number: 1 }]

            m.assertEqual(LastEpisodeOf(episodes).id, "e2")
            m.assertInvalid(LastEpisodeOf([]))
        end sub

        @describe("TimelineFraction")

        @it("measures how far through the whole title the viewer is")
        sub measuresProgress()
            m.assertEqual(TimelineFraction(30000, 120000), 0.25)
            m.assertEqual(TimelineFraction(0, 120000), 0.0)
            m.assertEqual(TimelineFraction(240000, 120000), 1.0)
        end sub

        @it("reads as empty when the duration is unknown")
        sub emptyWithoutDuration()
            m.assertEqual(TimelineFraction(30000, 0), 0.0)
            m.assertEqual(TimelineFraction(-1, 120000), 0.0)
        end sub

        @describe("TimelineSpan")

        @it("puts everything on the playback position when nothing is being scrubbed")
        sub spanWithoutScrub()
            span = TimelineSpan(30000, -1, 120000, 400)

            m.assertEqual(span.fillTo, 100)
            m.assertEqual(span.previewTo, 100)
            m.assertEqual(span.thumbAt, 100)
            m.assertFalse(span.ghost)
        end sub

        ' The accent stops where playback is; the muted span is the stretch the
        ' viewer is about to cross, which is what makes the jump readable.
        @it("leaves the accent behind and mutes the gap ahead")
        sub spanScrubbingForward()
            span = TimelineSpan(30000, 90000, 120000, 400)

            m.assertEqual(span.fillTo, 100)
            m.assertEqual(span.previewTo, 300)
            m.assertEqual(span.thumbAt, 100)
            m.assertEqual(span.ghostAt, 300)
            m.assertTrue(span.ghost)
        end sub

        ' Jumping back mutes the stretch about to be given up, so the muted span
        ' always describes the jump rather than the direction.
        @it("mutes the stretch between the target and now when scrubbing back")
        sub spanScrubbingBack()
            span = TimelineSpan(90000, 30000, 120000, 400)

            m.assertEqual(span.fillTo, 100)
            m.assertEqual(span.previewTo, 300)
            m.assertEqual(span.thumbAt, 300)
            m.assertEqual(span.ghostAt, 100)
        end sub

        @it("paints no span when the scrub sits on the playback position")
        sub spanScrubbingNowhere()
            span = TimelineSpan(30000, 30000, 120000, 400)

            m.assertEqual(span.fillTo, span.previewTo)
            m.assertTrue(span.ghost)
        end sub

        @describe("NextEpisodeAfter")

        @it("finds the episode that follows, in broadcast order")
        sub findsTheFollowingEpisode()
            items = [
                { id: "e3", season_number: 1, number: 3 },
                { id: "e1", season_number: 1, number: 1 },
                { id: "e2", season_number: 1, number: 2 }
            ]

            m.assertEqual(TextOrBlank(ValueAt(NextEpisodeAfter(items, "e1"), "id", "")), "e2")
            m.assertEqual(TextOrBlank(ValueAt(NextEpisodeAfter(items, "e2"), "id", "")), "e3")
        end sub

        @describe("FirstEpisodeOf")

        @it("opens a new season on its first episode, whatever order it arrived in")
        sub opensTheSeasonOnEpisodeOne()
            items = [{ id: "e2", number: 2 }, { id: "e1", number: 1 }]

            m.assertEqual(TextOrBlank(ValueAt(FirstEpisodeOf(items), "id", "")), "e1")
            m.assertInvalid(FirstEpisodeOf([]))
            m.assertInvalid(FirstEpisodeOf(invalid))
        end sub

        @it("finds nothing after the last episode, which is where the next season is asked for")
        sub stopsAtTheSeasonEnd()
            items = [{ id: "e1", season_number: 1, number: 1 }]

            m.assertInvalid(NextEpisodeAfter(items, "e1"))
            m.assertInvalid(NextEpisodeAfter(items, "unknown"))
            m.assertInvalid(NextEpisodeAfter(invalid, "e1"))
        end sub

        @describe("PlayerDiagnostics")

        @it("reports what the session became and how it is running")
        sub reportsSessionDiagnostics()
            info = VideoInfo({ measuredBitrate: 4500, isUnderrun: true }, { percentage: 80 }, 1.25, "playing")
            rows = PlayerDiagnostics({ mode: "transcode", container: "mpegts" }, info)

            m.assertEqual(rows[0].values[0], "transcode")
            m.assertEqual(rows[1].values[0], "mpegts")
            m.assertEqual(rows[2].values[0], "playing")
            m.assertEqual(rows[4].values[0], "4.5 Mbps")
            m.assertEqual(rows[5].values[0], "80%")
            m.assertEqual(rows[6].values[0], Phrase("state.yes"))
            m.assertEqual(rows[7].values[0], "1.3 s")
        end sub

        @it("names the timeline origin only when the manifest actually starts there")
        sub reportsTimelineOrigin()
            direct = PlayerDiagnostics({ mode: "direct", sequential: false, originMs: 0 }, VideoInfo(invalid, invalid, 0))
            m.assertEqual(direct[3].values[0], Phrase("diagnostics.fromStart"))

            shifted = PlayerDiagnostics({ mode: "transcode", sequential: true, originMs: 90000 }, VideoInfo(invalid, invalid, 0))
            m.assertEqual(shifted[3].values[0], FormatDuration(90000))
        end sub

        @it("says so rather than inventing numbers before playback reports any")
        sub saysNothingKnownYet()
            ' The server fields arrive with the session, the node fields only
            ' once it plays, so these two halves go unavailable separately.
            rows = PlayerDiagnostics(invalid, VideoInfo(invalid, invalid, 0))

            m.assertEqual(rows[0].values[0], Phrase("status.unavailable"))
            m.assertEqual(rows[2].values[0], Phrase("status.unavailable"))
            m.assertEqual(rows[4].values[0], Phrase("status.unavailable"))
            m.assertEqual(rows[7].values[0], Phrase("status.unavailable"))
            m.assertEqual(rows.Count(), 8)
        end sub

        @it("shows the newest log line, cut short, as the last event")
        sub showsTheLastEvent()
            line = "09:49:52 finished at 231.4/596.0 s, buffer 100%, and then some more text"
            rows = PlayerDiagnostics({ mode: "transcode" }, VideoInfo(invalid, invalid, 0), line)

            m.assertEqual(rows.Count(), 9)
            m.assertEqual(rows[8].label, Phrase("diagnostics.lastEvent"))
            m.assertEqual(rows[8].values[0], Left(line, LastEventLength()) + "…")
        end sub

        @describe("the playback log")

        @it("stamps each line with the local time")
        sub stampsTheTime()
            m.assertEqual(PlaybackClock(9, 5, 3), "09:05:03")
            m.assertEqual(PlaybackClock(23, 59, 0), "23:59:00")
        end sub

        @it("names the state, the position, the duration and the buffer")
        sub describesAState()
            m.assertEqual(PlaybackStateLine("09:49:52", "finished", 231.44, 596.0, 100), "09:49:52 finished at 231.4/596.0 s, buffer 100%")
            m.assertEqual(PlaybackStateLine("09:49:50", "buffering", 0, 0, -1), "09:49:50 buffering at 0.0/? s")
        end sub

        @it("names an error by its code, message and detail")
        sub describesAnError()
            m.assertEqual(PlaybackErrorLine("09:49:52", -3, "Unable to load", "manifest 404"), "09:49:52 error [-3] Unable to load (manifest 404)")
            m.assertEqual(PlaybackErrorLine("09:49:52", -5, "Unsupported", ""), "09:49:52 error [-5] Unsupported")
        end sub

        @it("keeps the newest hundred lines")
        sub keepsTheNewestLines()
            m.assertEqual(PlaybackLogLimit(), 100)
            lines = []
            for i = 0 to PlaybackLogLimit()
                AppendPlaybackLog(lines, "line " + i.ToStr())
            end for

            m.assertEqual(lines.Count(), PlaybackLogLimit())
            m.assertEqual(lines[0], "line 1")
            m.assertEqual(lines[lines.Count() - 1], "line " + PlaybackLogLimit().ToStr())
        end sub

        @it("joins the lines for the dialog and says when there are none")
        sub joinsTheLines()
            m.assertEqual(PlaybackLogText(["a", "b"]), "a" + Chr(10) + "b")
            m.assertEqual(PlaybackLogText([]), Phrase("player.playbackLogEmpty"))
        end sub

        @it("cuts a long line and keeps a short one")
        sub clipsLines()
            m.assertEqual(ClipText("short", 10), "short")
            m.assertEqual(ClipText("abcdefghij", 4), "abcd…")
        end sub

        @describe("FormatKbps")

        @it("reads as kbps below a megabit and Mbps above it")
        sub formatsBitrate()
            m.assertEqual(FormatKbps(850), "850 kbps")
            m.assertEqual(FormatKbps(8000), "8.0 Mbps")
            m.assertEqual(FormatKbps(0), "")
        end sub

        @describe("AbrBounds")

        @it("always names a switching strategy")
        sub alwaysNamesAStrategy()
            ' Roku is reported not to adapt at all unless this is set, whatever
            ' the documented default says.
            m.assertFalse(IsBlank(AbrBounds(0).strategy))
        end sub

        @it("bounds the bitrate only when it was given one")
        sub boundsOnlyWhenKnown()
            m.assertEqual(AbrBounds(0).maxKbps, 0)
            m.assertEqual(AbrBounds(8000000).maxKbps, 8000)
        end sub

        @describe("QualityRungs")

        @it("offers only the rungs below what the source actually is")
        sub offersRungsBelowTheSource()
            ' Asking the server to convert 1080p up to 1080p is work for nothing.
            heights = []
            for each rung in QualityRungs(1080)
                heights.Push(rung.height)
            end for

            m.assertEqual(heights, [0, 720, 480, 320])
        end sub

        @it("offers every rung when the source height is unknown")
        sub offersEveryRungWhenUnknown()
            m.assertEqual(QualityRungs(0).Count(), QualityHeights().Count())
            m.assertEqual(QualityRungs(0)[0].label, Phrase("player.original"))
            m.assertEqual(QualityRungs(0)[1].label, "1080p")
        end sub

        @it("reads the source height off the first video track")
        sub readsSourceHeight()
            m.assertEqual(SourceHeightOf({ video: [{ height: 2160 }] }), 2160)
            m.assertEqual(SourceHeightOf({ video: [] }), 0)
            m.assertEqual(SourceHeightOf(invalid), 0)
        end sub

        @describe("SubtitleOptions")

        @it("always offers Off first, then embedded tracks, then files")
        sub offersSubtitlesInOrder()
            options = SubtitleOptions({
                subtitles: [{ index: 2, language: "en", format: "subrip" }],
                subtitle_files: [{ id: "f1", language: "de", format: "webvtt" }]
            })

            m.assertEqual(options.Count(), 3)
            m.assertEqual(options[0].label, Phrase("state.off"))
            m.assertInvalid(options[0].ref)
            m.assertEqual(options[1].ref.type, "embedded")
            m.assertEqual(options[1].ref.index, 2)
            m.assertEqual(options[2].ref.type, "file")
            m.assertEqual(options[2].ref.id, "f1")
        end sub

        @it("drops a file with no id rather than offering one that cannot be chosen")
        sub dropsUnusableSubtitleFiles()
            m.assertEqual(SubtitleOptions({ subtitle_files: [{ language: "de" }] }).Count(), 1)
        end sub

        @it("finds the option that matches what is selected")
        sub findsTheSelectedSubtitle()
            options = SubtitleOptions({ subtitles: [{ index: 0 }, { index: 3 }] })
            controls = DefaultControls()
            controls.subtitle = { type: "embedded", index: 3 }

            m.assertEqual(IndexOfSubtitle(options, controls), 2)
            m.assertEqual(IndexOfSubtitle(options, DefaultControls()), 0)
        end sub

        @it("names each subtitle by its language and its own name, never by format or source")
        sub namesSubtitlesByLanguage()
            options = SubtitleOptions({
                subtitles: [
                    { index: 2, language: "en", format: "srt" },
                    { index: 3, language: "en", format: "pgs", title: "SDH" },
                    { index: 4, language: "fr", format: "srt", forced: true }
                ],
                subtitle_files: [
                    { id: "f1", language: "en", format: "srt", source: "open_subtitles", label: "Paper.Skies.BluRay" },
                    { id: "f2", language: "es", format: "srt", source: "machine_translated" },
                    { id: "f3", language: "de", format: "vtt", source: "generated" },
                    { id: "f4", language: "en+fr", format: "srt", source: "combined" },
                    { id: "f5", format: "srt", source: "external" }
                ]
            })

            labels = []
            for each option in options
                labels.Push(option.label)
            end for
            m.assertEqual(labels, [
                Phrase("state.off"),
                "English",
                "English · SDH",
                "French · " + Phrase("track.forced"),
                "English · Paper.Skies.BluRay",
                "Spanish · " + Phrase("track.sourceTranslated"),
                "German · " + Phrase("track.sourceGenerated"),
                "English + French",
                Phrase("language.unknown")
            ])
        end sub

        @it("numbers entries that would read the same, from the second")
        sub numbersSameLabels()
            version = {
                audio: [
                    { index: 1, codec: "truehd", language: "en" },
                    { index: 2, codec: "ac3", language: "en" },
                    { index: 3, codec: "aac", language: "en", title: "Commentary" },
                    { index: 4, codec: "ac3", language: "en" }
                ],
                subtitles: [{ index: 5, language: "en", format: "srt" }],
                subtitle_files: [{ id: "f1", language: "en", format: "srt", source: "external" }]
            }

            audio = AudioOptions(version)
            m.assertEqual(audio[0].label, "English")
            m.assertEqual(audio[1].label, "English 2")
            m.assertEqual(audio[2].label, "English · Commentary")
            m.assertEqual(audio[3].label, "English 3")
            m.assertEqual(audio[3].index, 4)

            subtitles = SubtitleOptions(version)
            m.assertEqual(subtitles[1].label, "English")
            m.assertEqual(subtitles[2].label, "English 2")
        end sub

        @describe("SteppedOffset")

        @it("steps in both directions and stops at the bound")
        sub stepsTheOffset()
            m.assertEqual(SteppedOffset(0, OffsetStepMs()), OffsetStepMs())
            m.assertEqual(SteppedOffset(0, 0 - OffsetStepMs()), 0 - OffsetStepMs())
            m.assertEqual(SteppedOffset(OffsetBoundMs(), OffsetStepMs()), OffsetBoundMs())
            m.assertEqual(SteppedOffset(0 - OffsetBoundMs(), 0 - OffsetStepMs()), 0 - OffsetBoundMs())
        end sub

        @it("signs the offset so the direction is readable")
        sub labelsTheOffset()
            m.assertEqual(OffsetLabel(250), "+250 ms")
            m.assertEqual(OffsetLabel(-250), "-250 ms")
            m.assertEqual(OffsetLabel(0), "0 ms")
        end sub

        @describe("SettingsRows")

        @it("names every setting with the value it currently has")
        sub namesEverySetting()
            controls = DefaultControls()
            controls.delivery = "never"

            rows = SettingsRows(controls, { autoplay: false, autoplayDelay: 15, remaining: true, diagnostics: false })

            m.assertEqual(rows[0].label, Phrase("player.converting"))
            m.assertEqual(rows[0].detail, Phrase("player.deliveryNever"))
            m.assertEqual(rows[1].label, Phrase("player.timeDisplay"))
            m.assertEqual(rows[1].detail, Phrase("player.timeRemaining"))
            m.assertEqual(rows[2].label, Phrase("player.autoplayNext"))
            m.assertEqual(rows[2].detail, Phrase("state.off"))
            m.assertEqual(rows[3].label, Phrase("player.diagnostics"))
            m.assertEqual(rows[3].detail, Phrase("state.off"))
            m.assertEqual(rows[4].id, "playbackLog")
            m.assertEqual(rows[4].label, Phrase("player.playbackLog"))
        end sub

        @it("folds the delay into the autoplay row when autoplay is on")
        sub foldsDelayIntoAutoplay()
            rows = SettingsRows(DefaultControls(), { autoplay: true, autoplayDelay: 15, remaining: false, diagnostics: false })

            m.assertEqual(rows[2].label, Phrase("player.autoplayNext"))
            m.assertEqual(rows[2].detail, "15 seconds")
        end sub

        @describe("AutoplayOptions")

        @it("offers Off ahead of every delay the countdown allows")
        sub offersOffAheadOfDelays()
            options = AutoplayOptions()

            m.assertEqual(options.Count(), CountdownOptions().Count() + 1)
            m.assertEqual(options[0].value, AutoplayOffValue())
            m.assertEqual(options[0].label, Phrase("state.off"))
            m.assertEqual(options[1].value, CountdownOptions()[0].value)
        end sub

        @it("offers Immediately right after Off, apart from it and keyed like Flutter")
        sub offersImmediatelyAfterOff()
            options = AutoplayOptions()

            m.assertEqual(AutoplayOffValue(), 0)
            m.assertEqual(AutoplayImmediatelyValue(), -1)
            m.assertEqual(options[1].value, AutoplayImmediatelyValue())
            m.assertEqual(options[1].label, "Immediately")
        end sub

        @it("reads the stored pair back as the value the list is keyed on")
        sub readsStoredPairAsOneValue()
            m.assertEqual(AutoplayValue(false, 15), AutoplayOffValue())
            m.assertEqual(AutoplayValue(true, 15), 15)
            m.assertEqual(AutoplayValue(true, -1), AutoplayImmediatelyValue())
            m.assertEqual(AutoplayValue(true, invalid), DefaultCountdownSeconds())
            m.assertEqual(AutoplayValue(true, 7), DefaultCountdownSeconds())
        end sub

        @it("names Immediately in the settings row")
        sub namesImmediately()
            m.assertEqual(AutoplayLabel(true, AutoplayImmediatelyValue()), "Immediately")
            m.assertEqual(AutoplayLabel(false, AutoplayImmediatelyValue()), Phrase("state.off"))
        end sub

        @describe("TimeDisplayOptions")

        @it("keys Elapsed and Remaining so the current one can be preselected")
        sub keysTimeDisplayOptions()
            options = TimeDisplayOptions()

            m.assertEqual(options.Count(), 2)
            m.assertEqual(options[0].label, Phrase("player.timeElapsed"))
            m.assertEqual(options[1].label, Phrase("player.timeRemaining"))
            m.assertEqual(options[TimeDisplayValue(false)].label, Phrase("player.timeElapsed"))
            m.assertEqual(options[TimeDisplayValue(true)].label, Phrase("player.timeRemaining"))
        end sub

        @describe("PositionText")

        @it("counts up from the start when the viewer wants elapsed")
        sub countsUp()
            m.assertEqual(PositionText(60000, 3600000, false), FormatDuration(60000))
        end sub

        @it("counts down to the end when the viewer wants remaining")
        sub countsDown()
            m.assertEqual(PositionText(60000, 3600000, true), "-" + FormatDuration(3540000))
        end sub

        @it("never shows a negative remaining time past the end")
        sub neverGoesNegative()
            m.assertEqual(PositionText(3700000, 3600000, true), "-" + FormatDuration(0))
        end sub

        @it("falls back to the elapsed time when there is no duration to count down from")
        sub fallsBackWithoutDuration()
            m.assertEqual(PositionText(60000, 0, true), FormatDuration(60000))
        end sub

        @describe("autoplay delay")

        @it("offers a few delays and keeps ten as the default")
        sub offersDelays()
            m.assertEqual(DefaultCountdownSeconds(), 10)
            m.assertEqual(CountdownOptions().Count(), 5)
            m.assertEqual(CountdownOptions()[2].value, 10)
        end sub

        @it("refuses a delay it does not offer")
        sub refusesUnknownDelay()
            m.assertEqual(ClampedCountdownSeconds(15), 15)
            m.assertEqual(ClampedCountdownSeconds(-1), AutoplayImmediatelyValue())
            m.assertEqual(ClampedCountdownSeconds(7), DefaultCountdownSeconds())
            m.assertEqual(ClampedCountdownSeconds(0), DefaultCountdownSeconds())
        end sub

        @describe("stall watchdog")

        @it("counts a tick only while nothing is arriving")
        sub countsStalledTicks()
            m.assertEqual(StallTicks(4, 100, 100), 5)
            m.assertEqual(StallTicks(4, 100, 101), 0)
        end sub

        @it("treats buffering as progress, so a slow start is not a stall")
        sub bufferingIsProgress()
            m.assertEqual(ProgressMark(1000, 20), 1020)
            m.assertEqual(StallTicks(3, ProgressMark(1000, 20), ProgressMark(1000, 30)), 0)
        end sub

        @it("survives a video node that reports nothing yet")
        sub toleratesNoReadings()
            m.assertEqual(ProgressMark(invalid, invalid), 0)
        end sub

        @it("gives the stream twenty seconds before it says anything")
        sub waitsTwentySeconds()
            m.assertEqual(StallSeconds(), 20)
            m.assertFalse(IsStalled(19))
            m.assertTrue(IsStalled(20))
        end sub

        @describe("track carry")

        @it("remembers the language of the track, not its index")
        sub remembersLanguages()
            version = {
                audio: [{ index: 0, language: "en" }, { index: 1, language: "ja" }],
                subtitles: [{ index: 3, language: "sv" }]
            }
            controls = DefaultControls()
            controls.audioTrack = 1
            controls.subtitle = { "type": "embedded", index: 3 }

            carried = CarriedTracks(controls, version)
            m.assertEqual(carried.audioLanguage, "ja")
            m.assertEqual(carried.subtitleLanguage, "sv")
            m.assertFalse(carried.subtitleOff)
        end sub

        @it("finds the same language at a different index on the next episode")
        sub findsLanguageAtANewIndex()
            later = {
                audio: [{ index: 0, language: "ja" }, { index: 1, language: "en" }],
                subtitles: [{ index: 7, language: "sv" }]
            }

            controls = ControlsForCarried({ audioLanguage: "ja", subtitleLanguage: "sv", subtitleOff: false }, later)
            m.assertEqual(controls.audioTrack, 0)
            m.assertEqual(controls.subtitle.index, 7)
            m.assertEqual(controls.subtitle["type"], "embedded")
        end sub

        @it("carries a subtitle file by language too")
        sub carriesSubtitleFiles()
            version = { subtitle_files: [{ id: "f1", language: "sv" }] }
            controls = DefaultControls()
            controls.subtitle = { "type": "file", id: "f1" }

            carried = CarriedTracks(controls, version)
            m.assertEqual(carried.subtitleLanguage, "sv")

            later = { subtitle_files: [{ id: "f9", language: "sv" }] }
            m.assertEqual(ControlsForCarried(carried, later).subtitle.id, "f9")
        end sub

        @it("keeps subtitles off when the viewer turned them off")
        sub keepsSubtitlesOff()
            controls = DefaultControls()
            controls.subtitleOff = true
            controls.subtitle = { "type": "embedded", index: 3 }

            carried = CarriedTracks(controls, { subtitles: [{ index: 3, language: "sv" }] })
            m.assertTrue(carried.subtitleOff)
            m.assertEqual(carried.subtitleLanguage, "")

            later = ControlsForCarried(carried, { subtitles: [{ index: 3, language: "sv" }] })
            m.assertTrue(later.subtitleOff)
            m.assertInvalid(later.subtitle)
        end sub

        @it("falls back to the default when the next episode has no such language")
        sub fallsBackWhenLanguageIsMissing()
            controls = ControlsForCarried({ audioLanguage: "ja", subtitleLanguage: "sv", subtitleOff: false }, { audio: [{ index: 0, language: "en" }] })

            m.assertEqual(controls.audioTrack, DefaultControls().audioTrack)
            m.assertInvalid(controls.subtitle)
        end sub

        @it("matches a language whatever case the server sent it in")
        sub matchesLanguageCaseInsensitively()
            m.assertEqual(AudioIndexForLanguage({ audio: [{ index: 4, language: "JA" }] }, "ja"), 4)
        end sub

        @it("survives a version with no tracks at all")
        sub toleratesNoTracks()
            carried = CarriedTracks(DefaultControls(), invalid)

            m.assertEqual(carried.audioLanguage, "")
            m.assertEqual(carried.subtitleLanguage, "")
            m.assertEqual(ControlsForCarried(invalid, invalid).audioTrack, DefaultControls().audioTrack)
        end sub

        @describe("HideSecondsFor")

        @it("leaves the bar up long enough to be read aloud")
        sub holdsTheBarForSpeech()
            m.assertEqual(HideSecondsFor(false), ControlsHideSeconds())
            m.assertEqual(HideSecondsFor(true), SpokenControlsHideSeconds())
            m.assertTrue(SpokenControlsHideSeconds() > ControlsHideSeconds())
        end sub

        @describe("ClockText")

        @it("pads a 24 hour clock to four digits")
        sub padsTwentyFourHour()
            m.assertEqual(ClockText(9, 5, true), "09:05")
            m.assertEqual(ClockText(21, 30, true), "21:30")
            m.assertEqual(ClockText(0, 0, true), "00:00")
        end sub

        @it("names midnight and noon correctly on a 12 hour clock")
        sub namesMidnightAndNoon()
            m.assertEqual(ClockText(0, 5, false), "12:05 AM")
            m.assertEqual(ClockText(12, 0, false), "12:00 PM")
        end sub

        @it("drops the leading zero on a 12 hour clock but keeps it on the minutes")
        sub dropsLeadingHourZero()
            m.assertEqual(ClockText(9, 5, false), "9:05 AM")
            m.assertEqual(ClockText(21, 30, false), "9:30 PM")
        end sub

        @describe("DoubleBackMs")

        @it("measures a gesture, not a pause for thought")
        sub measuresAGesture()
            m.assertEqual(DoubleBackMs(), 750)
            m.assertTrue(DoubleBackMs() * 4 <= ControlsHideSeconds() * 1000)
        end sub

        @it("gives every row an id the screen can act on")
        sub everySettingHasAnId()
            rows = SettingsRows(DefaultControls(), {})
            rows.Append(AudioRows(DefaultControls(), invalid))
            rows.Append(SubtitleRows(DefaultControls(), invalid, "default", false))

            for each row in rows
                m.assertFalse(IsBlank(row.id))
                m.assertFalse(IsBlank(row.label))
            end for
        end sub

        @describe("SubtitleRows")

        @it("offers offset, size and burn-in only once a subtitle is on")
        sub subtitleRowsFollowTheSelection()
            off = SubtitleRows(DefaultControls(), invalid, "large", false)
            m.assertEqual(off.Count(), 1)
            m.assertEqual(off[0].id, "subtitle")

            controls = DefaultControls()
            controls.subtitle = { type: "embedded", index: 2 }

            on = SubtitleRows(controls, invalid, "large", false)
            m.assertEqual(on.Count(), 4)
            m.assertEqual(on[1].id, "offset")
            m.assertEqual(on[2].id, "subtitleSize")
            m.assertEqual(on[2].detail, Phrase("player.subtitleSizeLarge"))
            m.assertEqual(on[3].id, "burn")
        end sub

        @it("offers no offset or size for subtitles burned into the picture")
        sub burnedSubtitlesHaveNoOffsetOrSize()
            controls = DefaultControls()
            controls.subtitle = { type: "embedded", index: 2 }
            controls.burn = true

            rows = SubtitleRows(controls, invalid, "large", false)

            m.assertEqual(rows.Count(), 2)
            m.assertEqual(rows[0].id, "subtitle")
            m.assertEqual(rows[1].id, "burn")
        end sub

        @it("offers no offset or size for subtitles the server burned in")
        sub serverBurnedSubtitlesHaveNoOffsetOrSize()
            controls = DefaultControls()
            controls.subtitle = { type: "embedded", index: 2 }

            rows = SubtitleRows(controls, invalid, "large", true)

            m.assertEqual(rows.Count(), 2)
            m.assertEqual(rows[0].id, "subtitle")
            m.assertEqual(rows[1].id, "burn")
            m.assertEqual(rows[1].detail, Phrase("state.off"))
        end sub

        @describe("the subtitle size")

        @it("keeps only a size the player offers, else Default")
        sub keepsOfferedSize()
            m.assertEqual(ValidSubtitleSize("large"), "large")
            m.assertEqual(ValidSubtitleSize("SMALL"), "small")
            m.assertEqual(ValidSubtitleSize("huge"), "default")
            m.assertEqual(ValidSubtitleSize(invalid), "default")
        end sub

        @it("asks the Roku for the same step by name")
        sub captionStyleNamesTheStep()
            m.assertEqual(CaptionStyleFor("default"), { "Text/Size": "Default" })
            m.assertEqual(CaptionStyleFor("small"), { "Text/Size": "Small" })
            m.assertEqual(CaptionStyleFor("medium"), { "Text/Size": "Medium" })
            m.assertEqual(CaptionStyleFor("large"), { "Text/Size": "Large" })
            m.assertEqual(CaptionStyleFor("huge"), { "Text/Size": "Default" })
        end sub

        @it("labels every size")
        sub labelsEverySize()
            for each option in SubtitleSizeOptions()
                m.assertEqual(SubtitleSizeLabel(option.value), option.label)
                m.assertFalse(IsBlank(option.label))
            end for
        end sub

        @describe("AudioRows")

        @it("carries the track and the downmix together")
        sub audioRowsPairTrackAndDownmix()
            rows = AudioRows(DefaultControls(), invalid)

            m.assertEqual(rows.Count(), 2)
            m.assertEqual(rows[0].id, "audio")
            m.assertEqual(rows[1].id, "downmix")
        end sub

        @describe("ControlsStartBody")

        @it("sends nothing at all when nothing was chosen")
        sub startBodyIsEmptyByDefault()
            m.assertEqual(ControlsStartBody(DefaultControls()).Count(), 0)
        end sub

        @it("sends each choice under the name the server reads")
        sub startBodyNamesEveryChoice()
            controls = DefaultControls()
            controls.height = 720
            controls.burn = true
            controls.downmix = true
            controls.audioTrack = 2
            controls.delivery = "always"

            body = ControlsStartBody(controls)
            m.assertEqual(body.target_height, 720)
            m.assertTrue(body.force_burn)
            m.assertTrue(body.downmix_stereo)
            m.assertEqual(body.audio_track, 2)
            m.assertEqual(body.delivery, "always")
        end sub

        @it("wraps a subtitle in the selection the server expects")
        sub startBodyWrapsTheTrack()
            ' The start body takes { track, offset_ms }, not a bare track ref.
            controls = DefaultControls()
            controls.subtitle = { type: "embedded", index: 3 }
            controls.offsetMs = 250

            selection = ControlsStartBody(controls).subtitle
            m.assertEqual(selection.track.type, "embedded")
            m.assertEqual(selection.track.index, 3)
            m.assertEqual(selection.offset_ms, 250)
        end sub

        @it("turns subtitles off instead of naming one")
        sub startBodyTurnsSubtitlesOff()
            controls = DefaultControls()
            controls.subtitleOff = true
            controls.subtitle = { type: "embedded", index: 3 }

            body = ControlsStartBody(controls)
            m.assertTrue(body.subtitle_off)
            m.assertFalse(body.DoesExist("subtitle"))
        end sub

        @describe("ControlsUpdateBody")

        @it("always states every server-side choice")
        sub updateBodyAlwaysStatesEverything()
            ' An update replaces the session's settings, so an omitted field
            ' would read as a change back to the default.
            body = ControlsUpdateBody(DefaultControls())

            m.assertInvalid(body.target_height)
            m.assertFalse(body.force_burn)
            m.assertFalse(body.downmix_stereo)
            m.assertEqual(body.delivery, "auto")
            m.assertEqual(body.subtitle.action, "disable")
        end sub

        @it("sets a subtitle with its offset")
        sub updateBodySetsSubtitle()
            controls = DefaultControls()
            controls.subtitle = { type: "file", id: "f1" }
            controls.offsetMs = -500

            change = ControlsUpdateBody(controls).subtitle
            m.assertEqual(change.action, "set")
            m.assertEqual(change.track.type, "file")
            m.assertEqual(change.track.id, "f1")
            m.assertEqual(change.offset_ms, -500)
        end sub

        @it("disables subtitles when they are switched off")
        sub updateBodyDisablesSubtitles()
            controls = DefaultControls()
            controls.subtitle = { type: "embedded", index: 1 }
            controls.subtitleOff = true

            m.assertEqual(ControlsUpdateBody(controls).subtitle.action, "disable")
        end sub

        @describe("ControlsWithSelection")

        @it("adopts what the session actually selected")
        sub adoptsSelection()
            merged = ControlsWithSelection(DefaultControls(), {
                audio_track: 1,
                subtitle_track: { type: "embedded", index: 4 }
            })

            m.assertEqual(merged.audioTrack, 1)
            m.assertEqual(merged.subtitle.index, 4)
            m.assertFalse(merged.subtitleOff)
        end sub

        @it("keeps what it had when the session selected nothing")
        sub keepsControlsWithoutSelection()
            controls = DefaultControls()
            controls.height = 480

            m.assertEqual(ControlsWithSelection(controls, invalid).height, 480)
        end sub

        @describe("session requests")

        @it("addresses every session endpoint the player uses")
        sub addressesSessionEndpoints()
            beat = HeartbeatRequest("http://host", "t", "s1", 1500, "playing")
            m.assertEqual(beat.url, "http://host/api/v1/sessions/s1/progress")
            m.assertEqual(ParseJson(beat.body).position_ms, 1500)
            m.assertEqual(ParseJson(beat.body).state, "playing")

            seek = SeekSessionRequest("http://host", "t", "s1", 60000)
            m.assertEqual(seek.url, "http://host/api/v1/sessions/s1/seek")
            m.assertEqual(ParseJson(seek.body).position_ms, 60000)

            update = UpdateSessionRequest("http://host", "t", "s1", DefaultControls(), 5000)
            m.assertEqual(update.url, "http://host/api/v1/sessions/s1/update")
            m.assertEqual(ParseJson(update.body).position_ms, 5000)
            m.assertEqual(ParseJson(update.body).delivery, "auto")

            ended = EndSessionRequest("http://host", "t", "s1")
            m.assertEqual(ended.url, "http://host/api/v1/sessions/s1")
            m.assertEqual(ended.method, "DELETE")
        end sub

        @it("carries the chosen controls into the start body")
        sub startCarriesControls()
            controls = DefaultControls()
            controls.height = 720

            request = StartSessionRequest("http://host", "t", "v1", 0, CapabilitiesBody({}, 1), controls)
            body = ParseJson(request.body)

            m.assertEqual(body.version_id, "v1")
            m.assertEqual(body.target_height, 720)
            m.assertEqual(body.capabilities.platform, "roku")
        end sub

        @it("waits past the change bound for a start, an update or a seek, so the bound decides")
        sub changeRequestsOutlastTheBound()
            requests = [
                StartSessionRequest("http://host", "t", "v1", 0, CapabilitiesBody({}, 1)),
                UpdateSessionRequest("http://host", "t", "s1", DefaultControls(), 5000),
                SeekSessionRequest("http://host", "t", "s1", 60000)
            ]
            for each request in requests
                m.assertTrue(request.timeout > ChangeRequestSeconds())
            end for
            m.assertEqual(HeartbeatRequest("http://host", "t", "s1", 0, "paused").timeout, RequestTimeoutSeconds())
        end sub

        @it("names the progress state the server expects")
        sub progressStates()
            m.assertEqual(ProgressState(true), "playing")
            m.assertEqual(ProgressState(false), "paused")
        end sub

        @describe("ResumeRequest")

        @it("reads the stored position for this user and version")
        sub readsStoredPosition()
            request = ResumeRequest("http://host", "t", "u1", "v1")

            m.assertEqual(request.url, "http://host/api/v1/users/u1/progress/v1")
            m.assertEqual(request.method, "GET")
        end sub

    end class

end namespace
