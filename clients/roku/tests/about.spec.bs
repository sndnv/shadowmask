namespace tests

    @suite("about")
    class AboutTests extends rooibos.BaseTestSuite

        @describe("AboutTitle")

        @it("always names the application")
        sub namesTheApplication()
            m.assertTrue(Instr(1, AboutTitle(), Phrase("app.name")) > 0, AboutTitle())
        end sub

        @it("appends the version when the manifest carries one")
        sub appendsTheVersion()
            version = AppVersion()
            if IsBlank(version) then return

            m.assertEqual(AboutTitle(), Phrase("app.name") + " " + version)
        end sub

        @describe("AttributionRows")

        @it("credits the server's font in the shape FactList expects")
        sub creditsTheServedFont()
            rows = AttributionRows({ name: "Noto Sans CJK SC", regular: "cachefs:/fonts/a.otf" })

            m.assertEqual(rows.Count(), 1)
            m.assertEqual(rows[0].label, "Noto Sans CJK SC")
            m.assertEqual(rows[0].values, [Phrase("about.fontSource")])
        end sub

        @it("names the system font when no font came from the server")
        sub namesTheSystemFont()
            rows = AttributionRows({})

            m.assertEqual(rows.Count(), 1)
            m.assertEqual(rows[0].label, Phrase("about.systemFont"))
            m.assertEqual(rows[0].values, [Phrase("about.systemFontSource")])
        end sub

        @it("speaks of a licence only for a font from the server")
        sub fontLineFollowsTheFont()
            m.assertEqual(FontLine({ name: "Noto Sans CJK SC" }), Phrase("about.font"))
            m.assertEqual(FontLine({}), Phrase("about.systemFontLine"))
        end sub

        @describe("FontLicenseText")

        @it("reads a licence text from the path it is given")
        sub readsTheLicenceText()
            text = FontLicenseText("pkg:/manifest")

            m.assertTrue(Instr(1, text, "title=") > 0, "unexpected text")
        end sub

        @it("returns nothing when the file is missing, instead of failing")
        sub survivesAMissingFile()
            m.assertEqual(FontLicenseText("cachefs:/fonts/does-not-exist.txt"), "")
        end sub
    end class
end namespace
