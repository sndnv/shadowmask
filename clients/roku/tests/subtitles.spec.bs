namespace tests

    @suite("subtitles")
    class SubtitleTests extends rooibos.BaseTestSuite

        function file(lines as object) as string
            return lines.Join(Chr(10))
        end function

        function texts(cue as object) as object
            found = []
            for each line in cue.lines
                found.Push(line.text)
            end for
            return found
        end function

        function only(line as string) as object
            cues = SubtitleCues(m.file(["WEBVTT", "", "00:01.000 --> 00:02.000", line]))
            m.assertEqual(cues.Count(), 1)
            return cues[0].lines[0]
        end function

        function cue(startMs as integer, endMs as integer) as object
            return { startMs: startMs, endMs: endMs, reachMs: 0, lines: [{ text: "x", italic: false, bold: false, underline: false }] }
        end function

        function playingAt(positionMs as integer, nowMs as integer) as object
            clock = SubtitleClockState(SubtitleClockHeld(positionMs, nowMs, false), "playing", nowMs)
            return SubtitleClockRead(clock, positionMs, nowMs)
        end function

        function reached(cues as object) as object
            reach = 0
            for each one in cues
                if one.endMs > reach then reach = one.endMs
                one.reachMs = reach
            end for
            return cues
        end function

        @describe("reading a WebVTT file")

        @it("reads each cue's times and lines, in hours or minutes form, with or without an id")
        sub readsCues()
            cues = SubtitleCues(m.file([
                "WEBVTT",
                "",
                "1",
                "00:01.000 --> 00:03.500",
                "First line",
                "Second line",
                "",
                "01:00:00.000 --> 01:00:02.250 line:10% align:start",
                "Later"
            ]))

            m.assertEqual(cues.Count(), 2)
            m.assertEqual(cues[0].startMs, 1000)
            m.assertEqual(cues[0].endMs, 3500)
            m.assertEqual(m.texts(cues[0]), ["First line", "Second line"])
            m.assertEqual(cues[1].startMs, 3600000)
            m.assertEqual(cues[1].endMs, 3602250)
            m.assertEqual(m.texts(cues[1]), ["Later"])
        end sub

        @it("skips the header's lines and NOTE, STYLE and REGION blocks")
        sub skipsBlocks()
            cues = SubtitleCues(m.file([
                "WEBVTT - a title",
                "Kind: captions",
                "",
                "NOTE a comment",
                "",
                "NOTE",
                "00:05.000 --> 00:06.000 is not a cue here",
                "",
                "STYLE",
                "::cue { color: red }",
                "",
                "REGION",
                "id:r1",
                "",
                "00:01.000 --> 00:02.000",
                "Text"
            ]))

            m.assertEqual(cues.Count(), 1)
            m.assertEqual(m.texts(cues[0]), ["Text"])
        end sub

        @it("reads CRLF and CR line ends and a byte order mark")
        sub readsLineEnds()
            crlf = Chr(13) + Chr(10)
            text = Chr(65279) + "WEBVTT" + crlf + crlf + "00:01.000 --> 00:02.000" + crlf + "One" + crlf + "Two" + crlf + crlf + "00:03.000 --> 00:04.000" + Chr(13) + "Three"
            cues = SubtitleCues(text)

            m.assertEqual(cues.Count(), 2)
            m.assertEqual(m.texts(cues[0]), ["One", "Two"])
            m.assertEqual(m.texts(cues[1]), ["Three"])
        end sub

        @it("drops a block whose timing does not read, or that ends before it starts")
        sub dropsBadTimings()
            cues = SubtitleCues(m.file([
                "WEBVTT",
                "",
                "00:01 --> 00:02",
                "No milliseconds",
                "",
                "00:05.000 --> 00:04.000",
                "Backwards",
                "",
                "00:01.000 --> 00:02.000",
                "Kept"
            ]))

            m.assertEqual(cues.Count(), 1)
            m.assertEqual(m.texts(cues[0]), ["Kept"])
        end sub

        @it("strips tags and decodes the entities a cue may hold")
        sub stripsTags()
            m.assertEqual(m.only("<c.yellow>Hi</c> <v Bob>there</v> <00:00:01.500>now").text, "Hi there now")
            m.assertEqual(m.only("Tom &amp; Jerry &lt;b&gt;").text, "Tom & Jerry <b>")
            m.assertEqual(m.only("a&nbsp;b&lrm;c&rlm;").text, "a" + Chr(160) + "bc")
            m.assertEqual(m.only("&amp;lt;").text, "&lt;")
        end sub

        @it("keeps an angle bracket with no close as text")
        sub keepsOpenBracket()
            m.assertEqual(m.only("1 < 2").text, "1 < 2")
        end sub

        @it("drops a line left empty by its tags, and a cue with no line left")
        sub dropsEmptyLines()
            cues = SubtitleCues(m.file([
                "WEBVTT",
                "",
                "00:01.000 --> 00:02.000",
                "<i></i>",
                "",
                "00:03.000 --> 00:04.000",
                "Text",
                "<b> </b>"
            ]))

            m.assertEqual(cues.Count(), 1)
            m.assertEqual(m.texts(cues[0]), ["Text"])
        end sub

        @it("orders cues by start, keeping the file's order for equal starts")
        sub ordersCues()
            cues = SubtitleCues(m.file([
                "WEBVTT",
                "",
                "00:05.000 --> 00:06.000",
                "Late",
                "",
                "00:01.000 --> 00:03.000",
                "First",
                "",
                "00:01.000 --> 00:02.000",
                "Second"
            ]))

            m.assertEqual(m.texts(cues[0]), ["First"])
            m.assertEqual(m.texts(cues[1]), ["Second"])
            m.assertEqual(m.texts(cues[2]), ["Late"])
        end sub

        @it("reads an empty or headerless file as no cues")
        sub readsNothing()
            m.assertEqual(SubtitleCues("").Count(), 0)
            m.assertEqual(SubtitleCues("WEBVTT").Count(), 0)
            m.assertEqual(SubtitleCues("not a subtitle").Count(), 0)
        end sub

        @describe("whole-line styles")

        @it("styles a line its tag covers whole, nesting included")
        sub stylesWholeLines()
            m.assertTrue(m.only("<i>Let us go</i>").italic)
            m.assertTrue(m.only("<i><i>song</i> spoken</i>").italic)
            m.assertTrue(m.only("<i.loud>Classed</i>").italic)

            both = m.only("<b><u>Both</u></b>")
            m.assertTrue(both.bold)
            m.assertTrue(both.underline)
            m.assertFalse(both.italic)
        end sub

        @it("draws a line plain when a tag covers only part of it")
        sub partStylesArePlain()
            for each line in ["<i>Song</i> spoken", "<i>a</i> b <i>c</i>", "Plain", "<b>Bold</b> and <u>under</u>"]
                shown = m.only(line)
                m.assertFalse(shown.italic, line)
                m.assertFalse(shown.bold, line)
                m.assertFalse(shown.underline, line)
            end for
        end sub

        @it("carries a tag across a cue's lines, as ffmpeg writes SRT italics, and not into the next cue")
        sub carriesTagsAcrossLines()
            cues = SubtitleCues(m.file([
                "WEBVTT",
                "",
                "00:01.000 --> 00:03.000",
                "<i>Previously on",
                "we lost him</i>",
                "",
                "00:04.000 --> 00:05.000",
                "<b>Bold one",
                "and two</b> then plain",
                "",
                "00:06.000 --> 00:07.000",
                "<i>Left open",
                "",
                "00:08.000 --> 00:09.000",
                "Plain again"
            ]))

            m.assertTrue(cues[0].lines[0].italic)
            m.assertTrue(cues[0].lines[1].italic)
            m.assertTrue(cues[1].lines[0].bold)
            m.assertFalse(cues[1].lines[1].bold)
            m.assertTrue(cues[2].lines[0].italic)
            m.assertFalse(cues[3].lines[0].italic)
        end sub

        @it("styles a combined subtitle's second language line by line")
        sub stylesCombined()
            cues = SubtitleCues(m.file(["WEBVTT", "", "00:01.000 --> 00:03.000", "我们走吧", "<i>Let us go</i>", "<i>now</i>"]))
            lines = cues[0].lines

            m.assertEqual(m.texts(cues[0]), ["我们走吧", "Let us go", "now"])
            m.assertFalse(lines[0].italic)
            m.assertTrue(lines[1].italic)
            m.assertTrue(lines[2].italic)
        end sub

        @it("draws italic only text the italic font covers")
        sub italicCoverage()
            m.assertTrue(ItalicDrawable("Let us go, now!"))
            m.assertTrue(ItalicDrawable("Ça va? Привет. Γειά σου. Tiếng Việt"))
            m.assertTrue(ItalicDrawable("“Quoted” – and…"))
            m.assertTrue(ItalicDrawable("€5, ½ off™, −3"))
            m.assertFalse(ItalicDrawable("Ϣ"))
            m.assertFalse(ItalicDrawable("我们走吧"))
            m.assertFalse(ItalicDrawable("Go 我们"))
            m.assertFalse(ItalicDrawable("♪ A song ♪"))
        end sub

        @it("draws italic only when tagged, drawable and the font is there, and bold in Medium")
        sub picksTheFont()
            m.assertEqual(SubtitleFontRole({ text: "Let us go", italic: true, bold: false }, true), "italic")
            m.assertEqual(SubtitleFontRole({ text: "Let us go", italic: true, bold: false }, false), "regular")
            m.assertEqual(SubtitleFontRole({ text: "我们走吧", italic: true, bold: false }, true), "regular")
            m.assertEqual(SubtitleFontRole({ text: "Both", italic: true, bold: true }, true), "italic")
            m.assertEqual(SubtitleFontRole({ text: "我们", italic: true, bold: true }, true), "medium")
            m.assertEqual(SubtitleFontRole({ text: "Loud", italic: false, bold: true }, true), "medium")
            m.assertEqual(SubtitleFontRole({ text: "Plain", italic: false, bold: false }, true), "regular")
        end sub

        @describe("the cues on screen")

        @it("shows a cue from its start up to, not including, its end")
        sub showsCueSpan()
            cues = m.reached([m.cue(1000, 2000), m.cue(3000, 4000)])

            m.assertEqual(ActiveCues(cues, 999), [])
            m.assertEqual(ActiveCues(cues, 1000), [0])
            m.assertEqual(ActiveCues(cues, 1999), [0])
            m.assertEqual(ActiveCues(cues, 2000), [])
            m.assertEqual(ActiveCues(cues, 3500), [1])
            m.assertEqual(ActiveCues(cues, 4000), [])
        end sub

        @it("shows overlapping cues together, the earlier one first")
        sub showsOverlaps()
            cues = m.reached([m.cue(1000, 3000), m.cue(2000, 4000), m.cue(2500, 2600)])

            m.assertEqual(ActiveCues(cues, 2550), [0, 1, 2])
            m.assertEqual(ActiveCues(cues, 3500), [1])
        end sub

        @it("finds a long cue that began before the short ones around it")
        sub findsLongCue()
            cues = m.reached([m.cue(0, 10000), m.cue(1000, 2000), m.cue(3000, 4000)])

            m.assertEqual(ActiveCues(cues, 5000), [0])
            m.assertEqual(ActiveCues(cues, 3500), [0, 2])
            m.assertEqual(ActiveCues(cues, 10000), [])
        end sub

        @it("shows nothing with no cues")
        sub showsNothing()
            m.assertEqual(ActiveCues([], 1000), [])
        end sub

        @it("shows cues only once the stream has painted, and not once it has finished")
        sub showsOnlyWhilePainted()
            m.assertTrue(SubtitlesOnScreen(true, "playing"))
            m.assertTrue(SubtitlesOnScreen(true, "paused"))
            m.assertTrue(SubtitlesOnScreen(true, "buffering"))
            m.assertFalse(SubtitlesOnScreen(false, "buffering"))
            m.assertFalse(SubtitlesOnScreen(false, "none"))
            m.assertFalse(SubtitlesOnScreen(true, "finished"))
        end sub

        @it("redraws only when the cues on screen change")
        sub comparesIndexes()
            m.assertTrue(SameIndexes([], []))
            m.assertTrue(SameIndexes([1, 2], [1, 2]))
            m.assertFalse(SameIndexes([1, 2], [1]))
            m.assertFalse(SameIndexes([1, 2], [1, 3]))
        end sub

        @it("keeps each cue's reach, the latest end up to it, for the search")
        sub keepsReach()
            cues = SubtitleCues(m.file(["WEBVTT", "", "00:00.000 --> 00:10.000", "Long", "", "00:01.000 --> 00:02.000", "Short"]))

            m.assertEqual(cues[0].reachMs, 10000)
            m.assertEqual(cues[1].reachMs, 10000)
        end sub

        @describe("the subtitle clock")

        @it("ends a seek's hold on a reading near the target, with no state change")
        sub endsHoldNearTarget()
            clock = SubtitleClockHeld(0, 20000, m.playingAt(15000, 19000).playing)
            m.assertEqual(SubtitleClockAt(clock, 20500), 0)

            clock = SubtitleClockRead(clock, 600, 21000)
            m.assertEqual(SubtitleClockAt(clock, 21300), 900)
        end sub

        @it("ignores a reading from before the seek until the settle wait has passed")
        sub ignoresStaleReading()
            clock = SubtitleClockHeld(0, 20000, true)

            clock = SubtitleClockRead(clock, 15800, 20500)
            m.assertEqual(SubtitleClockAt(clock, 21000), 0)

            settled = 20000 + SeekSettleWaitMs()
            clock = SubtitleClockRead(clock, 2500, settled)
            m.assertEqual(SubtitleClockAt(clock, settled), 2500)
        end sub

        @it("keeps holding when the player plays, and runs on once the hold ends")
        sub holdsThroughPlaying()
            clock = SubtitleClockState(SubtitleClockHeld(60000, 1000, false), "buffering", 1500)
            clock = SubtitleClockState(clock, "playing", 3000)
            m.assertEqual(SubtitleClockAt(clock, 3400), 60000)

            clock = SubtitleClockRead(clock, 60200, 3500)
            m.assertEqual(SubtitleClockAt(clock, 3900), 60600)
        end sub

        @it("runs on from the last reading while playing, up to the lead")
        sub runsOn()
            clock = SubtitleClockRead(m.playingAt(0, 0), 5000, 10000)

            m.assertEqual(SubtitleClockAt(clock, 10000), 5000)
            m.assertEqual(SubtitleClockAt(clock, 10300), 5300)
            m.assertEqual(SubtitleClockAt(clock, 10000 + SubtitleClockLeadMs() + 5000), 5000 + SubtitleClockLeadMs())
            m.assertEqual(SubtitleClockAt(clock, 9000), 5000)
        end sub

        @it("stops at the estimate when paused or buffering, and runs on when played")
        sub stopsWhenPaused()
            clock = SubtitleClockRead(m.playingAt(0, 0), 5000, 10000)

            paused = SubtitleClockState(clock, "paused", 10400)
            m.assertEqual(SubtitleClockAt(paused, 20000), 5400)

            buffering = SubtitleClockState(clock, "buffering", 10200)
            m.assertEqual(SubtitleClockAt(buffering, 20000), 5200)

            played = SubtitleClockState(paused, "playing", 30000)
            m.assertEqual(SubtitleClockAt(played, 30100), 5500)
        end sub

        @it("takes a reading while paused without running on")
        sub readsWhilePaused()
            clock = SubtitleClockState(m.playingAt(0, 0), "paused", 100)
            clock = SubtitleClockRead(clock, 7000, 200)

            m.assertEqual(SubtitleClockAt(clock, 5000), 7000)
        end sub

        @describe("the subtitle file")

        @it("fetches the server's file only for an external delivery with captions on")
        sub fetchesExternalOnly()
            stream = { subtitleDelivery: "external", subtitleUrl: "/stream/t1/subtitles.vtt" }

            m.assertEqual(SubtitleFileUrl(stream, true), "/stream/t1/subtitles.vtt")
            m.assertEqual(SubtitleFileUrl(stream, false), "")
            m.assertEqual(SubtitleFileUrl({ subtitleDelivery: "burned", subtitleUrl: "/stream/t1/subtitles.vtt" }, true), "")
            m.assertEqual(SubtitleFileUrl({ subtitleDelivery: "external", subtitleUrl: "" }, true), "")
            m.assertEqual(SubtitleFileUrl(invalid, true), "")
        end sub

    end class

end namespace
