<?xml version="1.0" encoding="utf-8" ?>
<component name="EpisodeScreen" extends="Group">
    <script type="text/brightscript" uri="pkg:/components/screens/EpisodeScreen.brs" />
    <script type="text/brightscript" uri="pkg:/components/screens/LayoutTick.brs" />
    <script type="text/brightscript" uri="pkg:/components/screens/DetailHero.brs" />
    <script type="text/brightscript" uri="pkg:/components/screens/CardMenu.brs" />
    <script type="text/brightscript" uri="pkg:/components/api/Http.brs" />
    <script type="text/brightscript" uri="pkg:/source/util.brs" />
    <script type="text/brightscript" uri="pkg:/source/tokens.brs" />
    <script type="text/brightscript" uri="pkg:/source/strings.brs" />
    <script type="text/brightscript" uri="pkg:/source/about.brs" />
    <script type="text/brightscript" uri="pkg:/source/format.brs" />
    <script type="text/brightscript" uri="pkg:/source/api.brs" />
    <script type="text/brightscript" uri="pkg:/source/cards.brs" />
    <script type="text/brightscript" uri="pkg:/source/images.brs" />
    <script type="text/brightscript" uri="pkg:/source/catalog.brs" />
    <script type="text/brightscript" uri="pkg:/source/state.brs" />
    <script type="text/brightscript" uri="pkg:/source/detail.brs" />
    <script type="text/brightscript" uri="pkg:/source/prefs.brs" />
    <script type="text/brightscript" uri="pkg:/source/session.brs" />
    <script type="text/brightscript" uri="pkg:/source/screen.brs" />
    <script type="text/brightscript" uri="pkg:/source/capability.brs" />
    <script type="text/brightscript" uri="pkg:/source/playback.brs" />

    <interface>
        <field id="theme" type="assocarray" onChange="render" />
        <field id="themeName" type="string" />
        <field id="target" type="assocarray" onChange="render" />
        <field id="advance" type="string" alwaysNotify="true" />
        <field id="advanceTarget" type="assocarray" />
        <field id="toastRequest" type="assocarray" alwaysNotify="true" />
        <field id="choiceRequest" type="assocarray" />
        <field id="choiceResult" type="assocarray" onChange="onChoice" />
        <field id="release" type="boolean" onChange="onRelease" />
        <field id="section" type="string" />
        <field id="backdropUrl" type="string" />
        <field id="focusedChild" type="node" onChange="onFocus" />
    </interface>

    <children>
        <ActionBar id="crumbs" />
        <Group id="viewport">
            <Group id="stack">
                <Group id="hero">
                    <Rectangle id="art" />
                    <Poster id="poster" />
                    <Poster id="glyph" visible="false" />
                    <Label id="heading" />
                    <Label id="facts" />
                    <Label id="crew" />
                    <ActionBar id="navActions" />
                    <ActionBar id="actions" />
                    <Label id="overview" />
                    <ActionBar id="overviewToggle" />
                </Group>
            </Group>
        </Group>
        <ScrollBar id="scrollBar" />
        <Timer id="layoutTick" />
        <StateNote id="note" kind="loading" visible="false" />
    </children>
</component>
