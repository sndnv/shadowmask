<?xml version="1.0" encoding="utf-8" ?>
<component name="CardGrid" extends="Group">
    <script type="text/brightscript" uri="pkg:/components/widgets/CardGrid.brs" />
    <script type="text/brightscript" uri="pkg:/components/widgets/CardContent.brs" />
    <script type="text/brightscript" uri="pkg:/source/util.brs" />
    <script type="text/brightscript" uri="pkg:/source/tokens.brs" />
    <script type="text/brightscript" uri="pkg:/source/strings.brs" />
    <script type="text/brightscript" uri="pkg:/source/format.brs" />
    <script type="text/brightscript" uri="pkg:/source/api.brs" />
    <script type="text/brightscript" uri="pkg:/source/cards.brs" />
    <script type="text/brightscript" uri="pkg:/source/images.brs" />
    <script type="text/brightscript" uri="pkg:/source/catalog.brs" />
    <script type="text/brightscript" uri="pkg:/source/state.brs" />
    <script type="text/brightscript" uri="pkg:/source/detail.brs" />
    <script type="text/brightscript" uri="pkg:/source/prefs.brs" />
    <script type="text/brightscript" uri="pkg:/source/session.brs" />
    <script type="text/brightscript" uri="pkg:/source/screen.brs" />
    <script type="text/brightscript" uri="pkg:/source/capability.brs" />
    <script type="text/brightscript" uri="pkg:/source/playback.brs" />

    <interface>
        <field id="theme" type="assocarray" onChange="render" />
        <field id="cards" type="array" onChange="replaceCards" />
        <field id="appendCards" type="array" onChange="appendMore" />
        <field id="stateOffset" type="integer" value="0" />
        <field id="cardStates" type="array" alwaysNotify="true" onChange="refreshStates" />
        <field id="serverUrl" type="string" />
        <field id="gridHeight" type="float" value="800" onChange="render" />
        <field id="cardWidth" type="float" value="240" onChange="render" />
        <field id="captionRows" type="integer" value="3" onChange="render" />
        <field id="columns" type="integer" value="6" onChange="render" />
        <field id="aspect" type="string" value="poster" />
        <field id="loaded" type="integer" value="0" />
        <field id="dormant" type="boolean" value="false" onChange="onDormant" />
        <field id="focused" type="integer" value="0" alwaysNotify="true" />
        <field id="jumpTo" type="integer" value="-1" alwaysNotify="true" onChange="jumpToCard" />
        <field id="focusedCard" type="assocarray" alwaysNotify="true" />
        <field id="selected" type="assocarray" alwaysNotify="true" />
        <field id="focusedChild" type="node" onChange="onFocus" />
    </interface>

    <children>
        <MarkupGrid id="grid" />
    </children>
</component>
