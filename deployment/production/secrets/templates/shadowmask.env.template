# Shadowmask production secrets and configuration.
# Copy this file to ../shadowmask.env and fill in real values.
# This is a docker env_file: KEY=VALUE lines, no quoting, no variable expansion.

# Signing secrets (REQUIRED). Use high-entropy random strings, e.g. `openssl rand -hex 32`.
SHADOWMASK_JWT_SECRET=
SHADOWMASK_STREAM_SECRET=

# TMDB metadata provider API key (optional; metadata enrichment is skipped when unset).
SHADOWMASK_TMDB_API_KEY=

# OMDb API key (optional; supplements TMDB with content ratings and scores, and needs a TMDB key).
# OMDb data is CC BY-NC 4.0 - NonCommercial, so leave unset if this server is a commercial service.
SHADOWMASK_OMDB_API_KEY=

# OpenSubtitles API key (optional; subtitle search and download are skipped when unset).
SHADOWMASK_OPENSUBTITLES_API_KEY=

# Local AI (transcription, translation, upscaling) is optional and off by default. It is configured
# in docker-compose.yml (the -enrichment image tag, SHADOWMASK_ENRICHMENT_* toggles, and a models
# mount); see deployment/ENRICHMENT.md.

# First-run bootstrap admin (used only when SHADOWMASK_BOOTSTRAP_MODE is init or init-and-start).
SHADOWMASK_ADMIN_USERNAME=admin
SHADOWMASK_ADMIN_PASSWORD=
